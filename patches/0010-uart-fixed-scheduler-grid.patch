+namespace {
+bool rchase2_uart_grid_enabled()
+{
+	static const bool enabled = rchase2::UartClockPolicy::enabled(
+		std::getenv("RCHASE2_VR"), std::getenv("RCHASE2_UART_COALESCE"),
+		std::getenv("RCHASE2_UART_REFERENCE"));
+	return enabled;
+}
+
+attotime rchase2_uart_grid_after(const attotime &base)
+{
+	const auto grid = rchase2::UartClockPolicy::next_global_grid(base.seconds(), base.attoseconds());
+	return attotime(grid.seconds, grid.attoseconds);
+}
+
+bool rchase2_before_virtual_uart(const attotime &expiry, const attotime &base)
+{
+	return rchase2::UartClockPolicy::precedes_global_grid(
+		expiry.seconds(), expiry.attoseconds(), base.seconds(), base.attoseconds());
+}
+} // anonymous namespace
 
