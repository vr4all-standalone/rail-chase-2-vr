+
+bool i8251_device::fixed_clock_eligible() const
+{
+	return m_flags == I8251_NEXT_COMMAND && m_sync_byte_count == 0 &&
+		(m_mode_byte & 3) >= 2 && (m_br_factor == 16 || m_br_factor == 64) &&
+		m_txc_count >= 0 && m_txc_count < m_br_factor &&
+		(!BIT(m_command, 2) || (!is_receive_register_synchronized() && m_rxd == 1));
+}
+
+void i8251_device::fixed_clock_advance(uint64_t edge, bool quiet)
+{
+	const uint64_t count = edge > m_input_edge ? edge - m_input_edge : 0;
+	if(quiet && count) {
+		m_input_quiet_edges += count;
+		if(count > 1) ++m_input_groups;
+		m_input_max_group = std::max(m_input_max_group, count);
+	}
+	const bool was_busy = m_input_busy;
+	m_input_busy = true;
+	while(m_input_edge < edge) {
+		const int level = (++m_input_edge & 1) ? 1 : 0;
+		// Reuse every original state transition, including serial shift-register
+		// contents. Deferred edges are proven quiet by the eligibility/terminal
+		// bound; their callbacks cannot generate a pin or ready event.
+		write_txc(level);
+		write_rxc(level);
+	}
+	m_input_busy = was_busy;
+}
+
+void i8251_device::fixed_clock_sync(bool inclusive)
+{
+	if(!m_input_timer || m_input_busy) return;
+	const attotime now = machine().time();
+	const uint64_t whole = uint64_t(now.seconds()) * 1000000 + uint64_t(now.attoseconds() / 1000000000000LL);
+	const bool exact = !inclusive && (now.attoseconds() % 1000000000000LL == 0);
+	const uint64_t limit = rchase2::UartClockPolicy::flush_limit(whole, exact, m_input_pending);
+	fixed_clock_advance(limit, true);
+}
+
+void i8251_device::fixed_clock_schedule()
+{
+	if(!m_input_timer || m_input_busy) return;
+	const auto event = rchase2::UartClockPolicy::next(m_input_edge, m_txc_count,
+		m_br_factor, fixed_clock_eligible(), m_input_armed);
+	const attotime now = machine().time();
+	const uint64_t whole = uint64_t(now.seconds()) * 1000000 + uint64_t(now.attoseconds() / 1000000000000LL);
+	// Retaining an unchanged (or already due) timer is essential: cancelling
+	// and reinserting it would change ordering against simultaneous events.
+	if(rchase2::UartClockPolicy::keep_armed(m_input_pending, event.edge, whole)) return;
+	m_input_pending = event.edge;
+	m_input_prepare = event.prepare;
+	if(!event.prepare && event.edge != m_input_armed) m_input_armed = 0;
+	m_input_timer->adjust(attotime::from_usec(event.edge) - now);
+}
+
+TIMER_CALLBACK_MEMBER(i8251_device::fixed_clock_tick)
+{
+	++m_input_events;
+	const uint64_t edge = m_input_pending;
+	fixed_clock_advance(edge - 1, true);
+	if(m_input_prepare && fixed_clock_eligible()) {
+		// Only arm the terminal edge here. Do not consume this preparatory RX
+		// edge yet: an RXD transition at this exact timestamp must be applied
+		// first, just as with the original clock's late timer insertion.
+		m_input_armed = edge + 1;
+	} else {
+		fixed_clock_advance(edge, false);
+		m_input_armed = 0;
+	}
+	m_input_pending = 0;
+	m_input_prepare = false;
+	fixed_clock_schedule();
+}
+
+void i8251_device::device_pre_save()
+{
+	// At the save safe point all same-time pin callbacks have completed.
+	// Materialize quiet state, including a deferred preparatory rising edge.
+	fixed_clock_sync(true);
+}
