 void sound_sdl::sink_callback(void *userdata, uint8_t *data, int len)
 {
 	stream_info *stream = reinterpret_cast<stream_info *>(userdata);
-	stream->m_buffer.get((int16_t *)data, len / 2 / stream->m_buffer.channels());
+	if(stream->m_stretch.active()) {
+		const uint32_t frames=uint32_t(len)/4;
+		const double now=SDL_GetPerformanceCounter()*stream->m_audio_tick_seconds;
+		const bool paused=stream->m_runtime->pause_requested.load(std::memory_order_relaxed) ||
+			!stream->m_runtime->host_ready.load(std::memory_order_relaxed) ||
+			stream->m_runtime->quit_requested.load(std::memory_order_relaxed);
+		stream->m_stretch.read(reinterpret_cast<int16_t *>(data),frames,now,paused);
+		if(len&3) std::fill(data+frames*4,data+len,uint8_t(0));
+		return;
+	}
+	const uint32_t frames = len / 2 / stream->m_buffer.channels();
+	if(stream->m_audio_probe_enabled) {
+		const double now = SDL_GetPerformanceCounter() * stream->m_audio_tick_seconds;
+		stream->m_audio_probe.callback(frames, stream->m_buffer.available(), now);
+	}
+	stream->m_buffer.get((int16_t *)data, frames);
+}
+
+void sound_sdl::write_audio_probe(uint32_t id, const char *event, double now, const rchase2::AudioProbeRecord &r)
+{
+	if(!m_audio_log)
+		return;
+	std::fprintf(m_audio_log,
+		"AUDIO_PROBE stream=%u wall_s=%.6f event=%s seconds=%.6f pushes=%llu pushed_frames=%llu callbacks=%llu requested_frames=%llu missing_frames=%llu underrun_callbacks=%llu dropped_frames=%llu queue_min=%u queue_max=%u queue_end=%u max_push_gap_ms=%.3f max_callback_gap_ms=%.3f\n",
+		id, now, event, r.seconds,
+		static_cast<unsigned long long>(r.pushes), static_cast<unsigned long long>(r.pushed_frames),
+		static_cast<unsigned long long>(r.callbacks), static_cast<unsigned long long>(r.requested_frames),
+		static_cast<unsigned long long>(r.missing_frames), static_cast<unsigned long long>(r.underrun_callbacks),
+		static_cast<unsigned long long>(r.dropped_frames), r.queue_min, r.queue_max, r.queue_end,
+		r.max_push_gap_seconds * 1000.0, r.max_callback_gap_seconds * 1000.0);
+	std::fflush(m_audio_log);
+}
+
+void sound_sdl::write_audio_stretch(uint32_t id, const char *event, double now, const rchase2::AudioStretchRecord &record)
+{
+	const auto &d=record.delta;const auto &t=record.total;
+	// Cumulative atomic counters yield interval deltas. Queues, tempo and ratio
+	// are current gauges; gap fields remain explicitly cumulative maxima.
+	char line[2048];
+	std::snprintf(line,sizeof(line),
+		"AUDIO_STRETCH stream=%u wall_s=%.6f event=%s seconds=%.6f state=%u native_frames=%llu produced_frames=%llu requested_frames=%llu delivered_frames=%llu missing_frames=%llu warmup_frames=%llu paused_frames=%llu paused_input_frames=%llu input_drops=%llu output_drops=%llu callbacks=%llu underrun_callbacks=%llu input_blocks=%llu output_blocks=%llu input_queue=%u output_queue=%u tempo=%.6f input_ratio=%.6f cumulative_max_input_gap_ms=%.3f cumulative_max_output_gap_ms=%.3f\n",
+		id,now,event,record.seconds,t.state,
+		static_cast<unsigned long long>(d.native_frames),static_cast<unsigned long long>(d.output_frames),
+		static_cast<unsigned long long>(d.requested_frames),static_cast<unsigned long long>(d.delivered_frames),
+		static_cast<unsigned long long>(d.missing_frames),static_cast<unsigned long long>(d.warmup_frames),
+		static_cast<unsigned long long>(d.paused_frames),static_cast<unsigned long long>(d.paused_input_frames),
+		static_cast<unsigned long long>(d.input_dropped_frames),static_cast<unsigned long long>(d.output_dropped_frames),
+		static_cast<unsigned long long>(d.callbacks),static_cast<unsigned long long>(d.underrun_callbacks),
+		static_cast<unsigned long long>(d.input_blocks),static_cast<unsigned long long>(d.output_blocks),
+		t.input_queue_frames,t.output_queue_frames,t.tempo,t.input_ratio,t.max_input_gap_ms,t.max_output_gap_ms);
+	if(m_audio_log) {std::fputs(line,m_audio_log);std::fflush(m_audio_log);}
+	else osd_printf_verbose("%s",line);
 }
 
